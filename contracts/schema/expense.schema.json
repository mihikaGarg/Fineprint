        "fringe",
        "travel_domestic",
        "travel_foreign",
        "equipment",
        "supplies",
        "contractual",
        "participant_support",
        "meals",
        "alcohol",
        "entertainment",
        "lobbying",
        "fundraising",
        "other"
      ],
      "title": "ExpenseCategory",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
