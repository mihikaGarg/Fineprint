{
  "$comment": "Generated by contracts.export; SCHEMA_VERSION 0.2.0",
  "$defs": {
    "ClauseCitation": {
      "additionalProperties": false,
      "description": "A verbatim span of the source PDF that justifies a rule.\n\n`char_start`/`char_end` index into the extracted text of `page` (1-based page,\n0-based half-open char range). The citation verifier checks that\npage_text[char_start:char_end] == quote; rules that fail are rejected.",
      "properties": {
        "char_end": {
          "minimum": 1,
          "title": "Char End",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "page",
        "char_start",
        "char_end",
        "quote"
      ],
      "title": "ClauseCitation",
      "type": "object"
    },
    "RuleEvaluation": {
      "additionalProperties": false,
      "description": "One line of the clause trace: how a single rule judged the expense.",
      "properties": {
        "citation": {
          "$ref": "#/$defs/ClauseCitation"
        },
        "outcome": {
          "$ref": "#/$defs/RuleOutcome"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "outcome",
        "reason",
        "citation"
      ],
      "title": "RuleEvaluation",
      "type": "object"
    },
    "RuleOutcome": {
      "enum": [
        "PASS",
        "FAIL",
        "ESCALATE",
        "NOT_APPLICABLE"
      ],
      "title": "RuleOutcome",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "ALLOWED",
        "BLOCKED",
        "NEEDS_REVIEW"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "ENFORCE output. The verdict must follow from the trace.",
  "properties": {
    "expense_id": {
      "minLength": 1,
      "title": "Expense Id",
      "type": "string"
    },
    "ruleset_id": {
      "minLength": 1,
      "title": "Ruleset Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/RuleEvaluation"
      },
      "title": "Trace",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "expense_id",
    "ruleset_id",
    "schema_version",
    "verdict",
    "trace"
  ],
  "title": "Decision",
  "type": "object"
}
